# ==============================================================================
# MediKiosk Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
# Dev 1 tables: interview_transcripts, summaries, red_flag_events
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medikiosk
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/medikiosk
# For local offline testing without Postgres running:
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./medikiosk_dev.db

# LLM & Conversation Intelligence (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Bhashini Indic Speech Services (ASR & TTS)
# Note: Fallbacks to Web Speech API / plain-text if keys are empty
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_PIPELINE_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ABDM & Kiosk Configuration
ABDM_SANDBOX_URL=https://dev.abdm.gov.in
KIOSK_ID=KIOSK-AIIMS-DELHI-OPD-01
DEFAULT_LANGUAGE=hi
IDLE_TIMEOUT_SECONDS=180
